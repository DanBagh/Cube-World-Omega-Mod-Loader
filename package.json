    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
